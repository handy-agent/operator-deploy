# Copy to .env (git-ignored). Read by ops.py; passed on to sst.
# AWS: profile handyagent-tools (~/.aws/config: credential_process over the `aws login --profile handyagent` session).
AWS_PROFILE=
# Cloudflare: token with Zone → DNS → Edit on handyagent.dev only. SST creates the stage domains with it.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DEFAULT_ACCOUNT_ID=
