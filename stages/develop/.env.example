# develop secrets — copy to .env (git-ignored) and fill. deploy.sh checks every uncommented name is set,
# then copies them to SSM (/handyagent/operator/develop/secret/, SecureString), where the server reads them.
# Commented names are optional: synced when present in .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
BASE_LATITUDE=
BASE_LONGITUDE=
# THUMBTACK_API_TOKEN=     (once Thumbtack Partner API access is approved)
